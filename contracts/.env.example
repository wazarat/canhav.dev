# Robinhood Chain testnet (Arbitrum Orbit, ArbOS 61, Cancun-capable)
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Deployer key. NEVER commit a real key; use a throwaway testnet account.
# Fund it at https://faucet.testnet.chain.robinhood.com
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Deployed contracts the later scripts reuse (DeployV4, DeployCurve).
LAUNCH_TOKEN_IMPL=0x3E8c9be8BB486abEc132B0d1C35266b2336b129B
LAUNCH_AMM=0xDd070b1f8e000D27491A3d38543ef0D72C758Df4
TIMELOCK=0x080cCDC07e2a0a5D11e9dDaA873ea68F540109ae

# CurveLauncher parameters (DeployCurve). Immutables, so pick before deploying.
# Defaults are the testnet calibration. Measure the L2 block cadence on the
# explorer before choosing the window; it is in seconds because block.number
# on Arbitrum Nitro chains reports the parent chain.
GRADUATION_ETH=100000000000000000
CURVE_SHARE_BPS=8000
SNIPE_WINDOW_SECONDS=60
SNIPE_TAX_BPS=2000
MAX_DEV_BUY_BPS=500
