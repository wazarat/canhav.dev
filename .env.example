# Dune Analytics API key — powers the Robinhood Chain "Protocol analytics"
# section on the landing page. Create one at dune.com → Settings → API.
# Server-side only (no NEXT_PUBLIC_ prefix); results are cached for 1 hour,
# so a free-tier key is sufficient. Without a key the section renders the
# committed snapshot from content/analytics.ts.
DUNE_API_KEY=

# Launchpad indexer (Ponder). Local dev: http://localhost:42069 (run
# `cd indexer && npm run dev`). Production/preview on Vercel point at the
# hosted instance: https://canhav-indexer.onrender.com
INDEXER_URL=http://localhost:42069

# Neon Postgres (journeys live in the `launchpad` schema; DB shared with
# another project — never touch other schemas). Locally:
#   npx vercel env pull .env.local --environment=preview
# then one-time setup: node --env-file=.env.local scripts/db-setup.mjs
DATABASE_URL=

# ERC-8004 registries on Base Sepolia (chain 84532) for the hidden /agents
# track. Public singletons — we own no contracts here. NEXT_PUBLIC_ because
# client components read AGENT_CHAIN (build-time inlined; the repo's first
# NEXT_PUBLIC_ vars). The testnet Identity Registry starts 0x8004A818; the
# MAINNET one starts 0x8004A169 — the site, verify script, and agents indexer
# all refuse anything not matching the testnet prefix, because the mixup
# otherwise fails silently.
NEXT_PUBLIC_AGENTS_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_AGENTS_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Base Sepolia RPC for server-side reads on /agents and the verify script.
# Optional — defaults to the public https://sepolia.base.org, which rate-limits
# aggressively; use a free Alchemy/provider URL for anything sustained.
AGENTS_RPC_URL=

# Agents indexer (Ponder, indexer-agents/). Local dev: http://localhost:42070
# (run `cd indexer-agents && npm run dev` — 42069 belongs to the launch
# indexer). Production: https://canhav-agents-indexer.onrender.com
AGENTS_INDEXER_URL=http://localhost:42070

# Vercel Blob (token images, content-addressed). Create a Blob store for the
# canhav-dev project in the Vercel dashboard (Storage → Blob), then re-pull env.
# Until set, /api/upload-image returns 503 and launches proceed without images.
BLOB_READ_WRITE_TOKEN=

# Clerk — AUTH ONLY for the ideation studio (/studio), the export routes,
# and the MCP server. All data stays in Neon's `launchpad` schema; Clerk
# issues the session whose user id (`user_…`) the `owner_id` columns store.
# Setup: create an application at clerk.com (email sign-in enabled), copy the
# API keys here and into Vercel. For the MCP server, also enable "Dynamic
# client registration" under OAuth applications. Optional but recommended:
# add a session-token custom claim {"email": "{{user.primary_email_address}}"}
# so authenticated requests never need a Backend API call. Until set, /studio
# shows a "sign-in not configured" chip and the ideation/export APIs return
# 503 — nothing else on the site is affected.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
