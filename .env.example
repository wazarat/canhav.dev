# Dune Analytics API key — powers the Robinhood Chain "Protocol analytics"
# section on the landing page. Create one at dune.com → Settings → API.
# Server-side only (no NEXT_PUBLIC_ prefix); results are cached for 1 hour,
# so a free-tier key is sufficient. Without a key the section renders the
# committed snapshot from content/analytics.ts.
DUNE_API_KEY=

# Launchpad indexer (Ponder). Local dev: http://localhost:42069 (run
# `cd indexer && npm run dev`). Production/preview on Vercel point at the
# hosted instance: https://canhav-indexer.onrender.com
INDEXER_URL=http://localhost:42069

# Neon Postgres (journeys live in the `launchpad` schema; DB shared with
# another project — never touch other schemas). Locally:
#   npx vercel env pull .env.local --environment=preview
# then one-time setup: node --env-file=.env.local scripts/db-setup.mjs
DATABASE_URL=

# Vercel Blob (token images, content-addressed). Create a Blob store for the
# canhav-dev project in the Vercel dashboard (Storage → Blob), then re-pull env.
# Until set, /api/upload-image returns 503 and launches proceed without images.
BLOB_READ_WRITE_TOKEN=
