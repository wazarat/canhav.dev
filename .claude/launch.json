{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "canhav-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "canhav-hosted-indexer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "INDEXER_URL=\"${INDEXER_URL:-https://canhav-indexer.fly.dev}\" npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "canhav-free",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "STUDIO_PLUS_DEV_FORCE=0 npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
