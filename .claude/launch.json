{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "canhav-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "canhav-hosted-indexer",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "INDEXER_URL=https://canhav-indexer.onrender.com",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
