# Indexer environment. See README.md for the deploy walkthrough.

# Which chain this instance indexes. Unset or anything else means Robinhood
# Chain Testnet (46630). Set to arbitrum_sepolia for the second instance,
# which needs its deployment recorded in ponder.config.ts first, its own
# DATABASE_SCHEMA (or its own database) and PONDER_RPC_URL_421614.
PONDER_CHAIN=

# Chain RPC for Arbitrum Sepolia. Falls back to the public endpoint.
PONDER_RPC_URL_421614=

# Chain RPC. Falls back to the public endpoint in ponder.config.ts, which
# rate-limits hard. Set a dedicated endpoint before a full backfill.
PONDER_RPC_URL_46630=

# Postgres. Ponder switches from embedded PGlite to Postgres purely on the
# presence of this (or DATABASE_PRIVATE_URL, which takes precedence).
# Leave both unset for local dev so PGlite is used.
# Do NOT point this at the app's Neon database: the indexer holds a pool of up
# to 30 persistent connections, which is what keeps Neon compute awake.
DATABASE_URL=

# Postgres schema the indexed tables live in. Defaults to `launchpad` in the
# start script. Only override it on a host that runs the old and new instance
# side by side during a deploy, where a shared schema would fail Ponder's
# migration check.
DATABASE_SCHEMA=

# HTTP port. Defaults to 42069 locally; hosts usually inject this.
PORT=
